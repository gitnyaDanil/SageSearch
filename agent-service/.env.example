# SageSearch Agent Service - Configuration Template
# Mode Selection: Use Vertex AI or standard Gemini API
USE_VERTEX_AI=true
GCP_PROJECT=your-gcp-project-id
GCP_REGION=global
GEMINI_MODEL=gemini-3.7-flash

# Authentication (for local development with Vertex AI)
# Download your Service Account JSON key and specify the absolute path:
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json

# (Alternative) Direct Gemini API Key:
# GEMINI_API_KEY=AIzaSy...

PORT=8080
