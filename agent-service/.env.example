# Gemini API Key (Required for live LLM mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Project Configuration (for Cloud Run and Firestore)
GCP_PROJECT=sagesearch-app
GCP_REGION=us-west4
FIRESTORE_DATABASE=(default)

# Agent Engine Configuration
GEMINI_MODEL=gemini-2.5-flash
MOCK_TOOLS=false
PORT=8080
